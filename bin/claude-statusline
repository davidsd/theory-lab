#!/usr/bin/env bash
# claude-statusline: Claude Code's status line on agentbox (set in ~/.claude/settings.json). Shows the
# model, context use and plan usage, and saves the plan usage (5-hour and 7-day windows) to
# /srv/lab/state/usage/claude-limits.json: Claude Code reports it only to status lines, and lab-usage
# and `lab spawn --model claude` read it from there.
input=$(cat)
usage=${LAB_DIR:-/srv/lab}/state/usage
limits=$(jq -c '.rate_limits // empty' <<<"$input" 2> /dev/null)
if [[ -n $limits && -d $usage ]]; then
  jq -n --argjson l "$limits" --argjson t "$(date +%s)" '{seen: $t, five_hour: $l.five_hour, seven_day: $l.seven_day}' \
    > "$usage/claude-limits.json.$$" && mv "$usage/claude-limits.json.$$" "$usage/claude-limits.json"
fi
jq -r '"[\(.model.display_name)] context \(.context_window.used_percentage // 0)%"
  + (if .rate_limits.five_hour then " · 5h \(.rate_limits.five_hour.used_percentage)%" else "" end)
  + (if .rate_limits.seven_day then " · 7d \(.rate_limits.seven_day.used_percentage)%" else "" end)' <<<"$input"
