#!/usr/bin/env bash
# lab-loop: the working cycle of the director and of each project's lead.
#   lab-loop director
#   lab-loop lead <project> [--final]
# Each pass is a fresh, non-interactive agent session that reads the files and the board, acts, and
# writes back, so nothing depends on an agent remembering anything. A lead skips a pass when nothing
# changed (no new comments, notebook entries or job changes), but runs at least every
# LEAD_MAX_IDLE_HOURS. `lab up` starts these loops in tmux windows; each pass prints one line there.
set -uo pipefail
source "${AGENTBOX_SHARE:-/usr/local/share/agentbox}/lib.sh"

lead_model() {  # lead_model <project>: the project's lead model (registry lead_model; default codex)
  local m
  m=$(project_field "$1" lead_model)
  echo "${m:-codex}"
}

lead_pass() {  # lead_pass <project> <claude|codex> [extra instructions]
  local project=$1 model=$2 extra=${3:-} folder=$PROJECTS/$1 stamp prompt code
  stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$folder/logs"
  prompt=$(render_role lead PROJECT="$project" ORG="$ORG" PI="$PI_GITHUB" \
    LIMIT="$(project_field "$project" limit)" ACCOUNT="$(id -un)")
  prompt+=$'\n\n## Right now\n\n'"Time: $(now)"$'\n\n'"This project's agents and Slurm jobs (id, name, state, elapsed; ids a1, a2, ... are agents outside Slurm):"$'\n'"$(lab_jobs "$project")"
  prompt+=$'\n\n'"$(cat "$USAGE/summary.txt" 2>/dev/null)"
  [[ -n $extra ]] && prompt+=$'\n\n'"$extra"
  echo "$(now) lead pass started"
  touch "$LAB/state/pass-lead-$project.running"
  run_agent "$model" "$folder" "$prompt" "$folder/logs/lead-$stamp.jsonl" "$folder/logs/lead-last.md"
  code=$?
  record_run "$model" "$folder/logs/lead-$stamp.jsonl" "$project" lead -
  rm -f "$LAB/state/pass-lead-$project.running"
  echo "$(now) lead pass ended (exit $code): $(head -c 300 "$folder/logs/lead-last.md" 2>/dev/null | tr '\n' ' ')"
}

fingerprint() {  # changes whenever the project's jobs, notebook or issues change
  local project=$1
  {
    lab_jobs "$project" | awk '{print $1, $2, $3}'   # not the elapsed time, which always changes
    find "$PROJECTS/$project/notebook" -type f -printf '%p %T@\n' 2>/dev/null
    gh issue list -R "$ORG/$project" --state all --limit 200 --json number,updatedAt < /dev/null 2>/dev/null
  } | cksum
}

# Watch passes for paused projects: every PAUSED_WATCH_HOURS, if anything changed (collaborators' commits,
# issues, notebook, jobs), one lead pass with WATCH_TEXT that reports to the PI only if the progress is
# significant. state/watch-<project> keeps the last watch's time and fingerprint.
PAUSED_WATCH_HOURS=${PAUSED_WATCH_HOURS:-72}
WATCH_TEXT='## This is a watch pass: the project is paused

The project is paused, so do not start work, spawn agents, change its state or reorganize the board. The PI wants
a paused project'"'"'s lead to check now and then for progress others made, and to report only if it is significant.
So: read what changed since the last watch (see "Watch:" in STATUS.md; if there is none, since the pause): commits
on main and branches by collaborators, issues and comments, notebook entries, the Slack mirror if there is one. If
there is significant progress (a result, a new method, a decision by a human, data that changes the picture), write
a short report yourself in the style of LAB-RULES.md "Project summaries" (what was done, by whom, why it matters
for the charter, questions for the PI in context): `summaries/<date>-watch.pdf` with its source (or wherever the
project'"'"'s own protocol puts the lab'"'"'s files), commit and push it, and send it as LAB-RULES.md "Project
summaries" says (with Slack: `lab-slack post --project <p> --role lead --channel <workspace>/@pi --issue <the
summary issue> --attach <pdf> --file <abstract>`; without Slack: a comment on the summary issue, labeled `summary`).
If nothing significant changed, send nothing. Either way, add one line to STATUS.md: "Watch: <date time>: <nothing
significant | reported: what>" and push.'

watch_fingerprint() {  # a paused project's fingerprint, with the remote's branches (collaborators' pushes)
  git -C "$PROJECTS/$1" fetch -q --all < /dev/null > /dev/null 2>&1 || true
  { fingerprint "$1"; git -C "$PROJECTS/$1" for-each-ref --format='%(refname) %(objectname)' refs/remotes 2> /dev/null; } | cksum
}

lead_loop() {
  local project=$1 last_fingerprint="" last_pass=0 status current model
  rm -f "$LAB/state/pass-lead-$project.running"   # left by a pass that was killed
  while :; do
    load_conf   # settings changes apply without a restart
    status=$(project_field "$project" status)
    if [[ $status == retired || -z $status ]]; then
      echo "Project $project is retired; this loop stops."
      return
    fi
    model=$(effective_model "$(lead_model "$project")")
    if [[ $status == active && $model == wait ]]; then
      echo "$(now) The lab's Claude share is used up and CLAUDE_FALLBACK=wait; waiting."
    elif [[ $status == active && $model == codex && $(codex_pressure) == stop ]]; then
      echo "$(now) Codex is at its limit (lab usage); waiting for the window to reset."
    elif [[ $status == paused && $model != wait ]] && ! [[ $model == codex && $(codex_pressure) == stop ]]; then
      local wfile=$LAB/state/watch-$project wtime=0 wprint="" wnow
      [[ -r $wfile ]] && read -r wtime wprint < "$wfile"
      if (( $(date +%s) - ${wtime:-0} >= PAUSED_WATCH_HOURS * 3600 )); then
        wnow=$(watch_fingerprint "$project")
        if [[ $wnow != "$wprint" ]]; then
          git -C "$PROJECTS/$project" pull -q --rebase --autostash < /dev/null > /dev/null 2>&1 || true
          echo "$(now) watch pass (paused project; something changed since the last watch)"
          lead_pass "$project" "$model" "$WATCH_TEXT"
          wnow=$(watch_fingerprint "$project")   # after the lead's own STATUS line
        fi
        echo "$(date +%s) $wnow" > "$wfile"
      fi
    elif [[ $status == active ]]; then
      # Bring in collaborators' and workers' pushes, so they count as changes.
      git -C "$PROJECTS/$project" pull -q --rebase --autostash < /dev/null > /dev/null 2>&1 || true
      current=$(fingerprint "$project")
      if [[ $current != "$last_fingerprint" ]] || (( $(date +%s) - last_pass >= LEAD_MAX_IDLE_HOURS * 3600 )); then
        # With the plan used up and CODEX_API=on, a Codex lead's pass runs on the OpenAI API.
        LAB_CODEX_API=$([[ $model == codex && $(codex_pressure) == api ]] && echo "overflow: the plan's window is used up") \
          lead_pass "$project" "$model"
        last_pass=$(date +%s)
        last_fingerprint=$(fingerprint "$project")   # after the lead's own changes
      fi
    fi
    sleep $(( LEAD_INTERVAL_MIN * 60 ))
  done
}

director_pass() {  # director_pass <claude|codex> [extra instructions]
  local model=$1 extra=${2:-} stamp prompt
  stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$LAB/state/logs"
  prompt=$(render_role director ORG="$ORG" PI="$PI_GITHUB")
  prompt+=$'\n\n## Right now\n\n'"Time: $(now)"$'\n\n'"Projects (registry.json):"$'\n'"$(jq -c '.projects' "$LAB/registry.json")"
  prompt+=$'\n\n'"The lab's agents and Slurm jobs (id, name, state, elapsed; ids a1, a2, ... are agents outside Slurm):"$'\n'"$(lab_jobs)"
  prompt+=$'\n\n'"$(cat "$USAGE/summary.txt" 2>/dev/null)"
  [[ -n $extra ]] && prompt+=$'\n\n'"$extra"
  echo "$(now) director pass started${extra:+ (with digest)}"
  touch "$LAB/state/pass-director.running"
  run_agent "$model" "$LAB" "$prompt" "$LAB/state/logs/director-$stamp.jsonl" "$LAB/state/director-last.md"
  local code=$?
  record_run "$model" "$LAB/state/logs/director-$stamp.jsonl" lab director -
  rm -f "$LAB/state/pass-director.running"
  echo "$(now) director pass ended (exit $code): $(head -c 300 "$LAB/state/director-last.md" 2>/dev/null | tr '\n' ' ')"
  return $code
}

director_loop() {
  local today extra model
  rm -f "$LAB/state/pass-director.running"
  while :; do
    load_conf
    today=$(date +%F)
    extra=""
    if [[ $(cat "$LAB/state/last-digest" 2>/dev/null) != "$today" ]] && (( 10#$(date +%H) >= DIGEST_HOUR )); then
      extra="Also write today's digest (see \"Daily digest\" above)."
    fi
    model=$(effective_model "$DIRECTOR_MODEL")   # DIRECTOR_MODEL: lab.conf / limits.conf (`lab model director`)
    if [[ $model == wait ]]; then
      echo "$(now) The lab's Claude share is used up and CLAUDE_FALLBACK=wait; waiting."
    elif [[ $model == codex && $(codex_pressure) == stop ]]; then
      echo "$(now) Codex is at its limit (lab usage); waiting for the window to reset."
    elif LAB_CODEX_API=$([[ $model == codex && $(codex_pressure) == api ]] && echo "overflow: the plan's window is used up") \
         director_pass "$model" "$extra" && [[ -n $extra ]]; then
      echo "$today" > "$LAB/state/last-digest"
    fi
    sleep $(( DIRECTOR_INTERVAL_MIN * 60 ))
  done
}

case ${1:-} in
  director)
    director_loop ;;
  lead)
    [[ -n ${2:-} ]] || die "Usage: lab-loop lead <project> [--final]"
    if [[ ${3:-} == --final ]]; then
      final_model=$(effective_model "$(lead_model "$2")")
      [[ $final_model == wait ]] && final_model=codex   # the final pass runs anyway
      lead_pass "$2" "$final_model" "This is the project's final pass: it is being retired. Put a final summary at the top of STATUS.md (what was achieved, where the results are, open questions), comment on each open issue that it was not finished and close it, then commit and push."
    else
      lead_loop "$2"
    fi ;;
  *)
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
    exit 1 ;;
esac
