#!/usr/bin/env python3
"""lab-capacity [--days N]: how the lab's capacity was used, from state/usage/capacity.jsonl (sampled every
5 minutes by the dashboard server). For deciding the numbers: agent-pool size, project limits, machine size."""
import argparse
import json
import statistics
import time

ap = argparse.ArgumentParser()
ap.add_argument("--days", type=float, default=7)
ap.add_argument("--file", default="/srv/lab/state/usage/capacity.jsonl")
a = ap.parse_args()
cut = time.time() - a.days * 86400
rows = []
for line in open(a.file):
    try:
        r = json.loads(line)
        if time.mktime(time.strptime(r["time"][:19], "%Y-%m-%dT%H:%M:%S")) >= cut:
            rows.append(r)
    except (ValueError, KeyError):
        pass
if not rows:
    raise SystemExit("No samples yet.")


def q(xs, p):
    xs = sorted(x for x in xs if x is not None)
    return None if not xs else xs[min(len(xs) - 1, int(p * len(xs)))]


def line(label, xs, unit="", total=None):
    xs = [x for x in xs if x is not None]
    if not xs:
        return
    s = f"  {label:<34} median {q(xs, .5):>6.1f}{unit}  p90 {q(xs, .9):>6.1f}{unit}  max {max(xs):>6.1f}{unit}"
    if total:
        s += f"   (of {total})"
    print(s)


def frac(pred):
    return 100 * sum(1 for r in rows if pred(r)) / len(rows)


hours = len(rows) * 5 / 60
print(f"{len(rows)} samples, about {hours:.1f} h, {rows[0]['time'][:16]} to {rows[-1]['time'][:16]}")
print("Machine")
line("CPUs actually busy", [r.get("busy_cpus") for r in rows], total=rows[-1]["cpus"])
line("Slurm CPUs given out", [r.get("slurm_alloc") for r in rows], total=rows[-1].get("slurm_total"))
line("load (1 min)", [r.get("load1") for r in rows])
line("memory used", [r.get("mem_used_gb") for r in rows], " GB", total=f"{rows[-1]['mem_total_gb']:.0f} GB")
print(f"  Slurm fully given out:             {frac(lambda r: r.get('slurm_alloc') == r.get('slurm_total')):.0f}% of the time")
print("Queue")
line("jobs waiting", [r["queue"]["pending"] for r in rows])
line("longest wait", [r["queue"]["max_wait_min"] for r in rows], " min")
line("lab-run jobs waiting", [r["queue"]["lab_run_pending"] for r in rows])
print(f"  something waiting:                 {frac(lambda r: r['queue']['pending'] > 0):.0f}% of the time")
print("Agent pools")
for user in sorted({u for r in rows for u in r.get("pools", {})}):
    ps = [r["pools"][user] for r in rows if user in r.get("pools", {})]
    cap = ps[-1].get("cap")
    line(f"{user}: CPUs used", [p.get("used") for p in ps], total=f"{cap:g} cap" if cap else None)
    line(f"{user}: memory", [p.get("mem_gb") for p in ps], " GB")
    if cap:
        print(f"  {user}: above 80% of its cap:        {100 * sum(1 for p in ps if (p.get('used') or 0) >= .8 * cap) / len(ps):.0f}% of samples")
print("Projects (agents running against the limit)")
for name in sorted({k for r in rows for k in r.get("projects", {})}):
    ps = [r["projects"][name] for r in rows if name in r.get("projects", {})]
    act = [p for p in ps if p.get("status") == "active"]
    if not act:
        print(f"  {name:<20} paused throughout")
        continue
    at = 100 * sum(1 for p in act if p.get("limit") and p["agents"] >= p["limit"]) / len(act)
    print(f"  {name:<20} median {q([p['agents'] for p in act], .5)}  max {max(p['agents'] for p in act)}"
          f"  limit {act[-1].get('limit')}   at the limit {at:.0f}% of the time")
cw = [r.get("claude_week_pct") for r in rows if r.get("claude_week_pct") is not None]
xw = [r.get("codex_week_pct") for r in rows if r.get("codex_week_pct") is not None]
if cw or xw:
    print("Model allowances (weekly %, first -> last sample)")
    if cw:
        print(f"  Claude {cw[0]} -> {cw[-1]}")
    if xw:
        print(f"  Codex  {xw[0]} -> {xw[-1]}")
