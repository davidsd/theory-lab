#!/usr/bin/env bash
# lab: run the lab's projects and agents.
#
#   lab status                          projects, agents and jobs at a glance
#   lab up                              start everything that should be running (e.g. after a reboot)
#   lab new <project> [--account agent|hpc] [--describe "<one line>"] [--charter <file>]
#                                       create a project (GitHub repo + folder); the PI approves its charter
#   lab adopt <project> [--account agent|hpc] [--describe "<one line>"] [--charter <file>]
#                                       bring an existing repo, already in the lab's organization, into
#                                       the lab: adds the lab's files next to its own; the PI approves
#   lab start <project>                 mark a project active and start its lead
#   lab pause <project>                 the lead stops; running jobs finish
#   lab resume <project>
#   lab retire <project> [--no-summary] final summary, stop its agents, archive its repo
#   lab limit <project> <n>             how many jobs the project may run at once
#   lab budget <project> <SUs>          the project's monthly HPC budget (0: none of its own)
#   lab usage [--refresh]               Codex, Claude and HPC use against limits and budgets
#   lab set [<KEY> <value>|- --reason "<why>"]
#                                       working limits and model policy (limits.conf), within lab.conf's
#                                       ceilings; no arguments: show every value, its source and ceiling
#   lab model <project>|director|default claude|codex [--reason "<why>"]
#                                       which model a project's lead, the director, or new agents use
#   lab spawn <project> worker|explorer|verifier --issue <n> [--model codex|claude] [--effort <level>] [--api "<why>"]
#             (without --model: DEFAULT_MODEL, see lab set)
#             [--cpus <n>] [--mem <size>] [--hours <n>]
#                                       start an agent on one issue: a user service in the agents' pool
#                                       (AGENT_RUNNER=systemd) or a Slurm job (AGENT_RUNNER=slurm); --api puts
#                                       a chosen Codex task on the OpenAI API (CODEX_API_BUDGET_USD)
#   lab chat <project>|lab [codex|claude]
#                                       talk about a project, or with the director about the whole lab
#                                       ("lab"), in a new tmux window
#   lab notify <title> <message> [url]  push a notification to the PI's phone
#   lab init                            one-time: put the lab folder on GitHub
#
# Projects belong to a Unix account: hpc if they use HPC, agent otherwise. hpc may run lab
# commands for the agent account; lab switches accounts by itself when needed.
set -euo pipefail
source "${AGENTBOX_SHARE:-/usr/local/share/agentbox}/lib.sh"

usage() {
  sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

need_project() {
  [[ -n ${1:-} ]] || usage 1
  project_exists "$1" || die "No project named $1 (see lab status)."
}

# Run a subcommand as the account that owns the project, in a separate process (so its failures
# show in its exit status).
as_owner() {  # as_owner <project> <subcommand> [args...]
  local project=$1; shift
  local account
  account=$(project_field "$project" account)
  if [[ $account == "$(id -un)" ]]; then
    "$0" "$@"
  else
    sudo -n -H -u "$account" "$0" "$@"
  fi
}

ensure_session() { tmux has-session -t agents 2>/dev/null || start-agents > /dev/null; }

# ensure_window <name> <process pattern> <command>: make sure the command runs in its own window of
# this account's session, restarting it in its window if its process (matched with pgrep -f) has gone.
ensure_window() {
  ensure_session
  if ! tmux list-windows -t agents -F '#W' | grep -qx -- "$1"; then
    tmux new-window -d -t agents: -n "$1" -c "$HOME"
  elif pgrep -u "$(id -un)" -f "$2" > /dev/null; then
    return 0
  fi
  tmux send-keys -t "agents:$1" "$3" Enter
}

render_files() {  # render_files <folder> KEY=value...: fill in {{KEY}} in every file under the folder
  local folder=$1 file text pair
  shift
  while IFS= read -r -d '' file; do
    text=$(cat "$file")
    for pair in "$@"; do
      text=${text//"{{${pair%%=*}}}"/"${pair#*=}"}   # quoted, so an & in the value stays an &
    done
    printf '%s\n' "$text" > "$file"
  done < <(find "$folder" -type f -name '*.md' -print0)
}

cmd_status() {
  local jobs
  jobs=$(lab_jobs || true)
  printf '%-24s %-6s %-9s %5s %5s  %s\n' PROJECT ACCOUNT STATUS LIMIT JOBS LEAD
  local project status lead count
  for project in $(jq -r '.projects | keys[]' "$LAB/registry.json"); do
    status=$(project_field "$project" status)
    [[ $status == retired ]] && continue
    count=$(awk -v p="lab:$project:" 'index($2, p) == 1' <<<"$jobs" | grep -c . || true)
    lead=-
    pgrep -f "lab-loop lead $project\$" > /dev/null && lead=running
    printf '%-24s %-6s %-9s %5s %5s  %s\n' "$project" "$(project_field "$project" account)" "$status" \
      "$(project_field "$project" limit)" "$count" "$lead"
  done
  echo
  echo "Jobs:"
  if [[ -n $jobs ]]; then sed 's/^/  /' <<<"$jobs"; else echo "  none"; fi
  echo
  echo "Machine: $(sinfo -h -o '%C' | awk -F/ '{print $1 " of " $4 " CPUs allocated"}')"
  pgrep -f 'lab-loop director$' > /dev/null && echo "Director: running" || echo "Director: not running"
  pgrep -f '/watchdog$' > /dev/null && echo "Watchdog: running" || echo "Watchdog: not running"
  [[ $(id -un) == hpc && -n ${HPC_LOGIN_HOST:-} ]] && hpc-check || true
}

cmd_up() {
  ensure_session
  if [[ $(id -un) == hpc ]]; then
    ensure_window rc 'claude remote-control' "cd $PROJECTS && claude remote-control --name $(hostname)-hpc --spawn same-dir"
    ensure_window watchdog '/watchdog$' watchdog
    ensure_window director 'lab-loop director$' "lab-loop director"
    ensure_window dashboard 'dashboard/serve.py' "python3 $LAB/dashboard/serve.py --port 8765"
  fi
  local project
  for project in $(projects_where account "$(id -un)"); do   # paused projects' loops run watch passes
    [[ $(project_field "$project" status) =~ ^(active|paused)$ ]] && ensure_window "lead-$project" "lab-loop lead $project\$" "lab-loop lead $project"
  done
  if [[ $(id -un) == hpc ]] && id agent &> /dev/null; then   # the second account is optional
    sudo -n -H -u agent "$0" up
  fi
  echo "$(id -un): running. Attach with: tmux attach -t agents"
}

cmd_new() {
  local project=${1:-} account=hpc describe="" charter=""
  [[ $project =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "Project names use lowercase letters, digits and -."
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --account) account=$2; shift 2 ;;
      --describe) describe=$2; shift 2 ;;
      --charter) charter=$2; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  [[ $account == agent || $account == hpc ]] || die "--account is agent or hpc."
  [[ -z $charter || -r $charter ]] || die "Can't read $charter."
  project_exists "$project" && die "There is already a project named $project."
  if [[ -n $charter ]]; then   # copy it where the owning account can read it
    cp "$charter" "$LAB/state/charter-$project.md.new" && mv "$LAB/state/charter-$project.md.new" "$LAB/state/charter-$project.md"
    charter=$LAB/state/charter-$project.md
  fi
  registry_update '.projects[$p] = {account: $a, status: "proposed", limit: 3, description: $d, created: $t}' \
    --arg p "$project" --arg a "$account" --arg d "$describe" --arg t "$(date +%F)"
  if ! as_owner "$project" _create "$project" "$charter"; then
    registry_update 'del(.projects[$p])' --arg p "$project"
    die "Creating $project failed (see above); nothing was registered. Remove $PROJECTS/$project and the GitHub repo if they were made."
  fi
}

cmd_adopt() {
  local project=${1:-} account=hpc describe="" charter=""
  [[ $project =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "Give the repo's name in $ORG."
  shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --account) account=$2; shift 2 ;;
      --describe) describe=$2; shift 2 ;;
      --charter) charter=$2; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  [[ $account == agent || $account == hpc ]] || die "--account is agent or hpc."
  [[ -z $charter || -r $charter ]] || die "Can't read $charter."
  project_exists "$project" && die "There is already a project named $project."
  [[ -e $PROJECTS/$project ]] && die "$PROJECTS/$project already exists."
  gh repo view "$ORG/$project" --json name > /dev/null 2>&1 || die "There is no repo $ORG/$project (transfer it there first)."
  if [[ -n $charter ]]; then
    cp "$charter" "$LAB/state/charter-$project.md.new" && mv "$LAB/state/charter-$project.md.new" "$LAB/state/charter-$project.md"
    charter=$LAB/state/charter-$project.md
  fi
  registry_update '.projects[$p] = {account: $a, status: "proposed", limit: 3, description: $d, created: $t, adopted: true}' \
    --arg p "$project" --arg a "$account" --arg d "$describe" --arg t "$(date +%F)"
  if ! as_owner "$project" _adopt "$project" "$charter"; then
    registry_update 'del(.projects[$p])' --arg p "$project"
    die "Adopting $project failed (see above); nothing was registered. Remove $PROJECTS/$project if it was made."
  fi
}

cmd__adopt() {  # as the owner: clone the repo, add the lab's files it lacks, open the charter-approval issue
  local project=$1 charter=${2:-} folder=$PROJECTS/$1 file rel added=() describe url
  gh repo clone "$ORG/$project" "$folder" -- -q
  if [[ -n $charter && -e $folder/CHARTER.md ]]; then
    rm -rf "$folder"
    die "$ORG/$project already has a CHARTER.md; adopt it without --charter."
  fi
  describe=$(project_field "$project" description)
  # Add only the template's files the repo doesn't have; never overwrite the repo's own.
  while IFS= read -r -d '' file; do
    rel=${file#"$SHARE/project-template/"}
    [[ $rel == .gitignore ]] && continue
    if [[ ! -e $folder/$rel ]]; then
      mkdir -p "$(dirname "$folder/$rel")"
      cp "$file" "$folder/$rel"
      added+=("$folder/$rel")
    fi
  done < <(find "$SHARE/project-template" -type f -print0)
  if [[ -f $folder/.gitignore ]]; then   # merge the template's ignores into the repo's
    while IFS= read -r line; do
      grep -qxF -- "$line" "$folder/.gitignore" || printf '%s\n' "$line" >> "$folder/.gitignore"
    done < "$SHARE/project-template/.gitignore"
  else
    cp "$SHARE/project-template/.gitignore" "$folder/.gitignore"
  fi
  [[ -n $charter ]] && cp "$charter" "$folder/CHARTER.md"
  local pair text
  for file in "${added[@]}"; do   # fill in the placeholders, in the added files only
    [[ $file == *.md ]] || continue
    text=$(cat "$file")
    for pair in PROJECT="$project" DESCRIPTION="${describe:-(to be written)}" DATE="$(date +%F)" ORG="$ORG" PI="$PI_GITHUB"; do
      text=${text//"{{${pair%%=*}}}"/"${pair#*=}"}
    done
    printf '%s\n' "$text" > "$file"
  done
  git -C "$folder" add -A
  git -C "$folder" commit -q -m "lab: join the lab (AGENTS.md, CHARTER.md, STATUS.md, notebook/, people/ next to the existing files)"
  git -C "$folder" push -q
  ensure_labels "$ORG/$project"
  url=$(gh issue create -R "$ORG/$project" --title "Approve the charter for $project" \
    --label inbox --label ask --label charter-approval --assignee "$PI_GITHUB" \
    --body "The charter: https://github.com/$ORG/$project/blob/$(git -C "$folder" branch --show-current)/CHARTER.md

This project already existed; the lab added its own files next to the repo's and changed none of them.
Edit the charter if you like, then comment \`approve\` to start the project, or \`cancel\` to drop it.")
  echo "Adopted $ORG/$project into $folder"
  echo "Waiting for the PI to approve the charter: $url"
}

cmd__create() {  # as the owner: folder, GitHub repo, and the charter-approval issue
  local project=$1 charter=${2:-} folder=$PROJECTS/$1
  mkdir -p "$folder"
  cp -r "$SHARE/project-template/." "$folder/"
  local describe
  describe=$(project_field "$project" description)
  render_files "$folder" PROJECT="$project" DESCRIPTION="${describe:-(to be written)}" DATE="$(date +%F)" ORG="$ORG" PI="$PI_GITHUB"
  [[ -n $charter ]] && cp "$charter" "$folder/CHARTER.md"
  git -C "$folder" init -q -b main
  git -C "$folder" add -A
  git -C "$folder" commit -q -m "Start project $project"
  if gh repo view "$ORG/$project" --json name > /dev/null 2>&1; then
    # the PI created the (empty) repo, so the bot's token needs no Administration permission
    [[ $(gh api "repos/$ORG/$project" --jq .size 2> /dev/null) == 0 ]] ||
      die "$ORG/$project already exists and isn't empty; use \`lab adopt $project\` for an existing repo."
    git -C "$folder" remote add origin "https://github.com/$ORG/$project.git"
    git -C "$folder" push -q -u origin main
  else
    gh repo create "$ORG/$project" --private --source "$folder" --remote origin --push > /dev/null
  fi
  ensure_labels "$ORG/$project"
  local url
  url=$(gh issue create -R "$ORG/$project" --title "Approve the charter for $project" \
    --label inbox --label ask --label charter-approval --assignee "$PI_GITHUB" \
    --body "The charter: https://github.com/$ORG/$project/blob/main/CHARTER.md

Edit it if you like, then comment \`approve\` to start the project, or \`cancel\` to drop it.")
  echo "Created $folder and https://github.com/$ORG/$project"
  echo "Waiting for the PI to approve the charter: $url"
}

cmd_start() {
  need_project "${1:-}"
  registry_update '.projects[$p].status = "active"' --arg p "$1"
  as_owner "$1" _start-lead "$1"
}

cmd__start_lead() {
  ensure_window "lead-$1" "lab-loop lead $1\$" "lab-loop lead $1"
  echo "Project $1 is active; its lead runs in window lead-$1 of $(id -un)'s tmux session."
}

cmd_pause() {
  need_project "${1:-}"
  registry_update '.projects[$p].status = "paused"' --arg p "$1"
  echo "Project $1 is paused: its lead stops working at its next check (it still looks in every 72 h if something changed); running jobs finish."
}

cmd_resume() {
  need_project "${1:-}"
  cmd_start "$1"
}

cmd_retire() {
  need_project "${1:-}"
  local project=$1 summary=yes
  [[ ${2:-} == --no-summary ]] && summary=no
  as_owner "$project" _stop "$project"
  if [[ $summary == yes && $(project_field "$project" status) != proposed ]]; then
    echo "Asking the lead for a final summary..."
    as_owner "$project" _final-pass "$project"
  fi
  registry_update '.projects[$p].status = "retired"' --arg p "$project"
  gh repo archive "$ORG/$project" --yes > /dev/null
  echo "Project $project is retired; https://github.com/$ORG/$project is archived (read-only)."
}

cmd__final_pass() { lab-loop lead "$1" --final; }

cmd__stop() {  # as the owner: stop the lead and cancel the project's jobs
  tmux kill-window -t "agents:lead-$1" 2>/dev/null || true
  rm -f "$LAB/state/pass-lead-$1.running"
  local jobs id
  jobs=$(lab_jobs "$1" | awk '$1 ~ /^[0-9]/ {print $1}')
  [[ -z $jobs ]] || scancel $jobs
  for id in $(lab_agents "$1" | awk '{print $1}'); do cmd__stop_agent "$id" || true; done
}

cmd__stop_agent() {  # as the owner: stop agent <id>'s service (lab-worker then says on its issue how it ended)
  [[ ${1:-} =~ ^a[0-9]+$ ]] || die "Usage: lab _stop-agent a<N>"
  if ! user_systemctl is-active --quiet "$AGENT_UNIT_PREFIX-$1"; then
    echo "Agent $1 isn't running on $(id -un) (already ended)."
    return 0
  fi
  user_systemctl stop --no-block "$AGENT_UNIT_PREFIX-$1"
}

cmd_limit() {
  need_project "${1:-}"
  [[ ${2:-} =~ ^[0-9]+$ ]] || die "Usage: lab limit <project> <n>"
  registry_update '.projects[$p].limit = ($n | tonumber)' --arg p "$1" --arg n "$2"
  echo "Project $1 may now run $2 jobs at once."
}

cmd_budget() {
  need_project "${1:-}"
  [[ ${2:-} =~ ^[0-9]+$ ]] || die "Usage: lab budget <project> <SUs per month>"
  if [[ $2 == 0 ]]; then
    registry_update 'del(.projects[$p].hpc_sus_month)' --arg p "$1"
    echo "Project $1 has no HPC budget of its own; the lab's applies."
  else
    registry_update '.projects[$p].hpc_sus_month = ($n | tonumber)' --arg p "$1" --arg n "$2"
    echo "Project $1 may use $2 HPC SUs a month without asking the PI."
  fi
}

cmd_usage() {
  [[ ${1:-} == --refresh ]] && lab-usage
  cat "$USAGE/summary.txt" 2> /dev/null || echo "No measurements yet; the watchdog makes them every 30 minutes (or: lab usage --refresh, as hpc)."
}

limits_write() {  # limits_write <KEY> <value|->: set or remove KEY in limits.conf, under a lock
  local key=$1 value=$2
  (
    flock 9
    if [[ ! -e $LIMITS_CONF ]]; then
      printf '%s\n' "# Working values; the director edits these only on the PI's instruction, via \`lab set\`." \
        "# Ceilings are <KEY>_MAX in /etc/agentbox/lab.conf (root); a value above its ceiling is capped." > "$LIMITS_CONF"
    fi
    grep -v "^[[:space:]]*$key=" "$LIMITS_CONF" > "$LIMITS_CONF.tmp" || true
    [[ $value == - ]] || printf '%s=%s\n' "$key" "$value" >> "$LIMITS_CONF.tmp"
    mv "$LIMITS_CONF.tmp" "$LIMITS_CONF"
  ) 9>"$LAB/state/limits.lock"
}

cmd_set() {
  local key
  if [[ $# -eq 0 ]]; then
    printf '%-26s %-10s %-34s %s\n' KEY VALUE SOURCE CEILING
    for key in "${LIMIT_KEYS[@]}"; do
      printf '%-26s %-10s %-34s %s\n' "$key" "${!key}" "${CONF_SRC[$key]}" "${CONF_CEIL[$key]}"
    done
    for key in "${POLICY_KEYS[@]}"; do
      printf '%-26s %-10s %-34s %s\n' "$key" "${!key}" "${CONF_SRC[$key]}" -
    done
    return
  fi
  key=$1
  local value=${2:-} reason=""
  [[ ${3:-} == --reason && -n ${4:-} ]] && reason=$4
  [[ -n $value && -n $reason ]] || die 'Usage: lab set <KEY> <value>|- --reason "<why>" (lab set alone shows the values)'
  if [[ " ${LIMIT_KEYS[*]} " == *" $key "* ]]; then
    if [[ $value != - ]]; then
      [[ $value =~ ^[0-9]+$ ]] || die "$key takes a whole number."
      (( value <= CONF_CEIL[$key] )) || die "$key=$value is above its ceiling ${CONF_CEIL[$key]} (${key}_MAX in $LAB_CONF, root's; the PI raises it with sudo)."
    fi
  elif [[ " ${POLICY_KEYS[*]} " == *" $key "* ]]; then
    [[ $value == - ]] || policy_ok "$key" "$value" || die "$key is one of: $( [[ $key == CLAUDE_FALLBACK ]] && echo 'codex, wait' || echo 'claude, codex')."
  else
    die "Unknown key $key. Settable: ${LIMIT_KEYS[*]} ${POLICY_KEYS[*]}"
  fi
  local old=${!key}
  limits_write "$key" "$value"
  load_conf
  shared_append "$LAB/state/limits-log.tsv" "$(now)"$'\t'"$(id -un)"$'\t'"$key"$'\t'"$old"$'\t'"$value"$'\t'"${reason//[$'\t\n']/ }"
  if git -C "$LAB" rev-parse --git-dir > /dev/null 2>&1; then
    git -C "$LAB" add "$LIMITS_CONF" > /dev/null 2>&1 &&
      git -C "$LAB" commit -q -m "lab: set $key=$value ($reason)" -- "$LIMITS_CONF" > /dev/null 2>&1 || true
  fi
  echo "$key is now ${!key} (${CONF_SRC[$key]}); was $old."
}

cmd_model() {
  local target=${1:-} model=${2:-} reason="lab model"
  [[ ${3:-} == --reason && -n ${4:-} ]] && reason=$4
  [[ $model == claude || $model == codex ]] || die "Usage: lab model <project>|director|default claude|codex [--reason \"<why>\"]"
  case $target in
    director) cmd_set DIRECTOR_MODEL "$model" --reason "$reason" ;;
    default) cmd_set DEFAULT_MODEL "$model" --reason "$reason" ;;
    *)
      need_project "$target"
      registry_update '.projects[$p].lead_model = $m' --arg p "$target" --arg m "$model"
      echo "Project $target's lead now runs on $model (from its next pass)." ;;
  esac
}

cmd_spawn() {
  need_project "${1:-}"
  local project=$1
  if [[ $(project_field "$project" account) != "$(id -un)" ]]; then
    as_owner "$project" spawn "$@"
    return
  fi
  local role=${2:-} issue="" model=$DEFAULT_MODEL model_given="" effort="" cpus=2 mem=16G hours=12 api_why="" api=""
  [[ $role == worker || $role == explorer || $role == verifier ]] || die "The role is worker, explorer or verifier."
  shift 2
  while [[ $# -gt 0 ]]; do
    case $1 in
      --issue) issue=$2; shift 2 ;;
      --model) model=$2; model_given=1; shift 2 ;;
      --effort) effort=$2; shift 2 ;;
      --cpus) cpus=$2; shift 2 ;;
      --mem) mem=$2; shift 2 ;;
      --hours) hours=$2; shift 2 ;;
      --api) api_why=$2; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  [[ $issue =~ ^[0-9]+$ ]] || die "Give the task's issue number: --issue <n>"
  [[ $hours =~ ^[0-9]+$ ]] && (( hours >= 1 )) || die "--hours is a whole number of hours, at least 1."
  [[ $cpus =~ ^[0-9]+$ ]] && (( cpus >= 1 )) || die "--cpus is a whole number, at least 1."
  mem=${mem^^}; mem=${mem%B}                # 16g, 16GB -> 16G, as Slurm accepts them
  [[ $mem =~ ^[0-9]+$ ]] && mem=${mem}M     # Slurm reads a bare number as MB; say so for systemd too
  [[ $mem =~ ^[0-9]+[KMGT]$ ]] || die "--mem is like 16G or 8000M."
  [[ $model == codex || $model == claude ]] || die "--model is codex or claude."
  [[ -z $effort || $effort =~ ^(low|medium|high|xhigh|max)$ ]] || die "--effort is low, medium, high, xhigh or max."
  [[ $(project_field "$project" status) == active ]] || die "Project $project isn't active."
  # The default model, with Claude's share used up and CLAUDE_FALLBACK=codex, falls back to Codex.
  if [[ $model == claude && -z $model_given && $CLAUDE_FALLBACK == codex ]] && ! claude_room; then
    echo "The lab's Claude share is used up; starting on codex (CLAUDE_FALLBACK=codex)." >&2
    model=codex
  fi
  if [[ $model == codex && -n $api_why ]]; then   # a chosen task on the API: the plan's pace doesn't apply
    codex_api_room || die "The OpenAI API isn't available: no login in ~/.codex-api, or CODEX_API_BUDGET_USD is spent (lab usage)."
    api="chosen: $api_why"
  elif [[ $model == codex ]]; then
    case $(codex_pressure) in
      stop) [[ $role == verifier ]] || die "Codex is at its limit until the window resets (lab usage); only verifiers start now." ;;
      ahead) [[ $role == explorer ]] && die "The lab is using Codex faster than the allowance lasts (lab usage); explorers wait until the pace recovers." ;;
      api) api="overflow: the plan's window is used up" ;;
    esac
  else
    [[ -z $api_why ]] || die "--api is for Codex agents (--model codex)."
    claude_room || die "The lab's Claude allowance for this week is used up (lab usage); the rest of the plan is the PI's."
  fi
  local jobs limit
  # Compute subjobs consume Slurm resources, not research-agent slots.
  # Leads must also reserve slots for agents in interactive sessions.
  jobs=$(lab_jobs "$project" | awk '$2 ~ /^lab:[^:]+:(worker|explorer|verifier):[0-9]+$/')
  limit=$(project_field "$project" limit)
  if awk -v n="lab:$project:$role:$issue" '$2 == n' <<<"$jobs" | grep -q .; then
    die "A $role is already working on issue #$issue."
  fi
  # An issue assigned to someone other than the lab's agents is theirs (a collaborator's claim).
  local others
  others=$(timeout 60 gh issue view "$issue" -R "$ORG/$project" --json assignees --jq '.assignees[].login' < /dev/null 2> /dev/null |
    grep -vx -- "$(agents_login)" | paste -sd, - || true)
  [[ -z $others ]] || die "Issue #$issue is assigned to $others; it's theirs. Comment on it instead."
  if (( $(grep -c . <<<"$jobs" || true) >= limit )); then
    die "Project $project already runs $limit jobs, its limit. Wait for one to finish, or ask the PI for more."
  fi
  local folder=$PROJECTS/$project
  mkdir -p "$folder/logs"
  local job
  if [[ $AGENT_RUNNER == systemd ]]; then
    # A user service in the shared slice; its CPUs and memory come from the pool, and --cpus/--mem cap
    # this one agent within it. Its heavy work goes to Slurm (lab-run). lab-worker stops it at --hours.
    job=$(new_agent_id)
    agent_pool
    local -a envs=()
    local v
    for v in PATH HOME USER LOGNAME SHELL LANG LC_ALL TERM TZ TMPDIR XDG_CONFIG_HOME LAB_DIR PROJECTS_DIR LAB_CONF \
             AGENTBOX_SHARE AGENT_UNIT_PREFIX AGENT_SLICE CODEX_HOME GH_CONFIG_DIR http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
      [[ -n ${!v:-} ]] && envs+=(--setenv="$v=${!v}")
    done
    user_systemctl reset-failed "$AGENT_UNIT_PREFIX-$job" > /dev/null 2>&1 || true
    XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} systemd-run --user --quiet --collect \
      --unit="$AGENT_UNIT_PREFIX-$job" --slice="$AGENT_SLICE" --description="lab:$project:$role:$issue" \
      -p CPUQuota="${cpus}00%" -p MemoryMax="$mem" -p UMask=0002 -p KillMode=mixed -p TimeoutStopSec=180 \
      -p RuntimeMaxSec=$(( hours * 3600 + 900 )) --working-directory="$folder" "${envs[@]}" \
      --setenv=LAB_PROJECT="$project" --setenv=LAB_ROLE="$role" --setenv=LAB_ISSUE="$issue" \
      --setenv=LAB_MODEL="$model" --setenv=LAB_EFFORT="$effort" --setenv=LAB_AGENT_ID="$job" \
      --setenv=LAB_HOURS="$hours" --setenv=LAB_CPUS="$cpus" --setenv=LAB_MEM="$mem" ${api:+--setenv=LAB_CODEX_API="$api"} \
      bash -c "exec $(printf %q "$(command -v lab-worker)") >> $(printf %q "$folder/logs/$job-$role-$issue.out") 2>&1" \
      || die "systemd-run failed: is lingering on for $(id -un)? (sudo loginctl enable-linger $(id -un))"
    echo "Started $role for issue #$issue as agent $job ($model${effort:+, effort $effort}${api:+, on the OpenAI API}, outside Slurm, up to $hours h; computations go through lab-run)."
    return
  fi
  job=$(sbatch --parsable --job-name="lab:$project:$role:$issue" --cpus-per-task="$cpus" --mem="$mem" \
    --time="$hours:00:00" --signal=B:USR1@300 --output="$folder/logs/%j-$role-$issue.out" --chdir="$folder" \
    --export="ALL,LAB_PROJECT=$project,LAB_ROLE=$role,LAB_ISSUE=$issue,LAB_MODEL=$model,LAB_EFFORT=$effort${api:+,LAB_CODEX_API=$api}" \
    "$(command -v lab-worker)")
  echo "Started $role for issue #$issue as Slurm job $job ($model${effort:+, effort $effort}, $cpus CPUs, $mem, up to $hours h)."
}

cmd_chat() {
  local project=${1:-} tool=${2:-claude} folder prompt
  [[ $tool == codex || $tool == claude ]] || die "Chat with codex or claude."
  if [[ $project == lab ]]; then   # a conversation with the director, about the whole lab
    folder=$LAB
    prompt="You're the lab's director, talking with the PI in person (not one of your periodic passes). First read roles/director.md (your role), PRIORITIES.md, findings.md, director-notes.md and registry.json in $LAB, and the STATUS.md of each active project in $PROJECTS. Then help the PI plan: current and new projects, priorities, agent limits and budgets. For a new project, draft its charter with them, write it to $LAB/state/charter-<name>.md, and create the project with lab new (see lab help); it starts when they comment approve on the charter issue, so give them the link. Change limits, budgets and project states with lab commands only when they decide to. Record their decisions in director-notes.md (and in PRIORITIES.md when they're about what they want to hear about), then commit and push $LAB, so your periodic passes follow them. Answer plainly and briefly."
  else
    need_project "$project"
    folder=$PROJECTS/$project
    prompt="You're talking with the PI about project $project (folder $folder; board: GitHub issues in $ORG/$project). Before answering, read CHARTER.md, STATUS.md, DECISIONS.md, the newest notebook entries and the open issues. Answer plainly. If the PI gives an instruction or makes a decision, record it as a comment on the relevant issue (or a new issue) starting with \"From the PI (via chat):\" so the project's lead acts on it."
  fi
  ensure_session
  local name=chat-$project n=2
  while tmux list-windows -t agents -F '#W' | grep -qx -- "$name"; do
    name=chat-$project-$n
    n=$((n + 1))
  done
  tmux new-window -d -t agents: -n "$name" -c "$folder"
  tmux send-keys -t "agents:$name" "$tool $(printf '%q' "$prompt")" Enter
  if [[ -n ${TMUX:-} ]]; then
    tmux select-window -t "agents:$name"
  else
    exec tmux attach-session -t agents \; select-window -t "agents:$name"
  fi
}

cmd_notify() {
  [[ $# -ge 2 ]] || usage 1
  notify "$@"
}

cmd_init() {
  [[ -n ${ORG:-} && -n ${PI_GITHUB:-} ]] || die "Fill in $LAB_CONF first (sudo nano $LAB_CONF, from your own login)."
  [[ -d $LAB/.git ]] && die "$LAB is already a git repo."
  [[ -z $CONF_PLACEHOLDERS ]] ||
    echo "Warning: still CHANGE-ME in $LAB_CONF, treated as unset:$CONF_PLACEHOLDERS" >&2
  render_files "$LAB" ORG="$ORG" PI="$PI_GITHUB"
  git -C "$LAB" init -q -b main
  git -C "$LAB" add -A
  git -C "$LAB" commit -q -m "Start the lab"
  gh repo create "$ORG/lab" --private --source "$LAB" --remote origin --push > /dev/null
  ensure_labels "$ORG/lab"
  echo "The lab folder is now https://github.com/$ORG/lab"
}

command=${1:-help}
shift || true
case $command in
  help|-h|--help) usage ;;
  status|up|new|adopt|start|pause|resume|retire|limit|budget|usage|set|model|spawn|chat|notify|init|_create|_adopt|_start-lead|_final-pass|_stop|_stop-agent)
    "cmd_${command//-/_}" "$@" ;;
  *) usage 1 ;;
esac
