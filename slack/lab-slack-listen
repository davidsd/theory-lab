def claude_room():
    return subprocess.run(["bash", "-c", f"source {LIB}; claude_room"]).returncode == 0


def claude_flags():
    out = subprocess.run(["bash", "-c", f"source {LIB}; agent_flags claude responder"], capture_output=True, text=True)
    return out.stdout.split("\n")[:-1] if out.stdout else []


def readonly_flags(project):
    """For people who may not instruct the lab: read the project's files and board, nothing else. Their text
    reaches a model, so a hostile message must not be able to run commands or read tokens."""
    home = str(Path.home())
    others = [p for p in json.loads((LAB / "registry.json").read_text()).get("projects", {}) if p != project]
    deny = [f"{t}({path})" for t in ("Read", "Grep", "Glob")
            for path in [f"/{home}/**", "//etc/**", "//tmp/**", "//root/**", f"/{LAB}/**", "//srv/agents/**",
                         *[f"/{PROJECTS}/{o}/**" for o in others],
                         f"/{PROJECTS}/{project}/data/slack/**"]]
    deny += [f"{t}(//proc/**)" for t in ("Read", "Grep", "Glob")]
    # no user/project settings: their allow rules (lab-rm, the cancel tools) and hooks must not apply here.
    # gh runs in the project's clone, so it reads that repo's board; other repos (-R/--repo) are refused.
    return ["--setting-sources", "", "--tools", "Read,Grep,Glob,Bash", "--permission-mode", "dontAsk",
            "--allowedTools", "Bash(gh issue view:*)", "Bash(gh issue list:*)", "Bash(gh pr view:*)",
            "--disallowedTools", *deny, "Bash(gh * -R*)", "Bash(gh * --repo*)", f"Bash({LAB}/bin/*)",
            "Bash(/usr/local/bin/*)", "Bash(lab-rm:*)", "Bash(lab-cancel:*)", "Bash(hpc-cancel:*)", "Bash(hpc-submit:*)"]


def respond(prompt, cwd, project, readonly=True):
    RUNS.mkdir(parents=True, exist_ok=True)
    logf = RUNS / f"{time.strftime('%Y%m%d-%H%M%S')}-{project}.json"
    mode = readonly_flags(project) if readonly else ["--permission-mode", "auto"]
    with open(logf, "w") as f:
        subprocess.run(["claude", "-p", prompt, *mode, "--output-format", "json", *claude_flags()],
                       cwd=cwd, stdout=f, stderr=subprocess.DEVNULL, timeout=1200)
    subprocess.run(["bash", "-c", f'source {LIB}; record_run claude "$1" "$2" responder -', "_", str(logf), project])
    return (ls.read_json(logf, {}) or {}).get("result", "").strip()


