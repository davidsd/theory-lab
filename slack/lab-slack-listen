def pending_get(ws, uid):
    p = ls.read_json(PENDING, {}).get(f"{ws} {uid}")
    return tuple(p) if p else None


def pending_set(ws, uid, value):
    with lock:
        data = ls.read_json(PENDING, {})
        if value is None:
            data.pop(f"{ws} {uid}", None)
        else:
            data[f"{ws} {uid}"] = list(value)
        ls.write_atomic(PENDING, json.dumps(data))


def chunks(text, n=MAX_REPLY):
    """Split a long reply at paragraph (else line) breaks into Slack-sized messages."""
    out = []
    while len(text) > n:
        cut = text.rfind("\n\n", 0, n)
        cut = cut if cut > n // 3 else text.rfind("\n", 0, n)
        cut = cut if cut > n // 3 else n
        out.append(text[:cut].rstrip())
        text = text[cut:].lstrip("\n")
    return out + [text]


def log(*a):
    print(time.strftime("%Y-%m-%d %H:%M:%S"), *a, flush=True)


# --- identities

def norm(handle):
    handle = handle.strip().strip("`").lstrip("@")
    if ":" in handle:
        site, h = handle.split(":", 1)
        return f"{site.lower()}:{h}"
    return f"github:{handle}"


def agents_people(project):
    """Identities under "People" in the project's AGENTS.md (the lab itself excluded)."""
    try:
        text = (PROJECTS / project / "AGENTS.md").read_text()
    except OSError:
        return set()
    m = re.search(r"^## *People\s*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
    out = set()
    for line in (m[1] if m else "").splitlines():
        cell = re.match(r"\|([^|]*)\|", line)
        if not cell:
            continue
        # every handle in the first cell, e.g. `octocat` (GitLab `gitlab:octocat`)
        for h in re.findall(r"`([^`]+)`", cell[1]) or [cell[1].strip()]:
            if h not in ("Handle", "lab", "") and not set(h) <= set("-: "):
                out.add(norm(h))
    return out


def identities(ws, uid, name, people_conf):
    linked = ls.read_json(PEOPLE, {}).get(ws, {}).get(uid, [])
    ids = set(linked)
    if (ws, uid) in people_conf:   # by Slack user id only: display names aren't unique and anyone can change theirs
        ids.add(norm(people_conf[(ws, uid)]))
    return ids


def projects_for(ids):
    out = []
    for p in sorted(os.listdir(PROJECTS)):
        if ids & agents_people(p):
            out.append(p)
    return out


def repos_with_access(handle):
    """Project repos in the org where this GitHub user is a collaborator (so they can open issues there)."""
    out = []
    for p in sorted(os.listdir(PROJECTS)):
        r = subprocess.run(["gh", "api", f"repos/{ORG}/{p}/collaborators", "--jq", "[.[].login]"],
                           capture_output=True, text=True, timeout=30)
        if r.returncode == 0 and handle.lower() in [x.lower() for x in json.loads(r.stdout or "[]")]:
            out.append(f"{ORG}/{p}")
    return out


def unedited(repo, number):
    """True if neither the issue's body nor its title was ever edited: the bot account and collaborators can
    edit issues, so an edited issue proves nothing about who wrote the code into it."""
    owner, name = repo.split("/", 1)
    q = ("query($o:String!,$n:String!,$i:Int!){repository(owner:$o,name:$n){issue(number:$i){lastEditedAt "
         "timelineItems(itemTypes:[RENAMED_TITLE_EVENT]){totalCount}}}}")
    r = subprocess.run(["gh", "api", "graphql", "-f", f"query={q}", "-f", f"o={owner}", "-f", f"n={name}",
                        "-F", f"i={number}"], capture_output=True, text=True, timeout=30)
    try:
        issue = json.loads(r.stdout)["data"]["repository"]["issue"]
        return issue["lastEditedAt"] is None and issue["timelineItems"]["totalCount"] == 0
    except Exception:
        return False


def proof_found(identity, code):
    site, h = identity.split(":", 1)
    texts = []
    try:
        if site == "github":
            r = subprocess.run(["gh", "api", f"users/{h}"], capture_output=True, text=True, timeout=30)
            texts.append(json.loads(r.stdout).get("bio") or "")
            r = subprocess.run(["gh", "api", f"users/{h}/gists?per_page=10"], capture_output=True, text=True, timeout=30)
            texts += [g.get("description") or "" for g in json.loads(r.stdout or "[]")]
            # an issue they opened (the pre-filled link) in the org's repos they belong to, or the lab repo
            for repo in ([f"{ORG}/lab"] if identity == PI else repos_with_access(h)):
                r = subprocess.run(["gh", "api", f"repos/{repo}/issues?creator={h}&state=all&per_page=20"],
                                   capture_output=True, text=True, timeout=30)
                for item in json.loads(r.stdout or "[]") if r.returncode == 0 else []:
                    if (code in (item.get("title") or "") + (item.get("body") or "")
                            and (item.get("user") or {}).get("login", "").lower() == h.lower()
                            and unedited(repo, item["number"])):
                        texts.append(code)
                        if item["state"] == "open":
                            subprocess.run(["gh", "issue", "close", str(item["number"]), "-R", repo, "--comment",
                                            "lab (agent): linked. Thanks."], capture_output=True, timeout=60)
        elif site == "gitlab":
            get = lambda u: json.load(urllib.request.urlopen(urllib.request.Request(
                f"https://gitlab.com/api/v4/{u}", headers={"User-Agent": "lab-slack/1"}), timeout=30))
            users = get(f"users?username={h}")
            if users:
                uid = users[0]["id"]
                texts.append((get(f"users/{uid}/status") or {}).get("message") or "")
    except Exception as e:
        log("proof check failed:", identity, e)
    return any(code in t for t in texts)


